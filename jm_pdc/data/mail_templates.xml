<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Company to Customer Email Notification -->
    <record id="sh_pdc_company_to_customer_notification_1" model="mail.template">
        <field name="name">PDC Due Notification — Company to Customer</field>
        <field name="model_id" ref="jm_pdc.model_pdc_wizard"/>
        <field name="use_default_to" eval="True" />
        <field name="email_from">{{object.company_id.email}}</field>
        <field name="email_to">{{object.partner_id.email}}</field>
        <field name="lang">{{object.env.context.get("lang")}}</field>
        <field name="subject">Gentle Reminder — Cheque Due</field>
        <field name="body_html" type="html">
            <div style="line-height: 28px;">
                Dear <b><t t-out="object.partner_id.name" /></b>,<br/>
                This is a gentle reminder that your cheque reference no.
                <b><t t-out="object.reference" /></b>
                is due on <b><t t-out="object.due_date" /></b>.<br/>
                <div>Thank you.</div>
            </div>
        </field>
    </record>

    <!-- FIX #7: Vendor-specific notification template (was missing; vendor cron
         was incorrectly using the customer template above) -->
    <record id="sh_pdc_company_to_vendor_notification_1" model="mail.template">
        <field name="name">PDC Due Notification — Company to Vendor</field>
        <field name="model_id" ref="jm_pdc.model_pdc_wizard"/>
        <field name="use_default_to" eval="True" />
        <field name="email_from">{{object.company_id.email}}</field>
        <field name="email_to">{{object.partner_id.email}}</field>
        <field name="lang">{{object.env.context.get("lang")}}</field>
        <field name="subject">Gentle Reminder — Payment Cheque Due</field>
        <field name="body_html" type="html">
            <div style="line-height: 28px;">
                Dear <b><t t-out="object.partner_id.name" /></b>,<br/>
                This is a gentle reminder that the cheque with reference
                <b><t t-out="object.reference" /></b>
                issued to your account is due on <b><t t-out="object.due_date" /></b>.<br/>
                <div>Thank you.</div>
            </div>
        </field>
    </record>

    <!-- Company to Internal User Email Notification -->
    <record id="sh_pdc_company_to_int_user_notification_1" model="mail.template">
        <field name="name">PDC Due Notification — Company to Internal User</field>
        <field name="model_id" ref="jm_pdc.model_pdc_wizard"/>
        <field name="email_from">{{object.company_id.email}}</field>
        <field name="lang">{{object.env.context.get("lang")}}</field>
        <field name="subject">Gentle Reminder — Cheque Due</field>
        <field name="body_html" type="html">
            <div style="line-height: 28px;">
                Hello,<br/>
                <b><t t-out="object.partner_id.name" /></b>'s cheque reference no.
                <b><t t-out="object.reference" /></b>
                is due on <b><t t-out="object.due_date" /></b>.<br/>
                <a class="btn btn-primary" role="button"
                   t-att-href="'%s' % object.env.context.get('customer_url')">View Cheque</a><br/>
                <div>Thank you.</div>
            </div>
        </field>
    </record>

</odoo>
