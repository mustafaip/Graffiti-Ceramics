<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plain form for the settings singleton - no wizard machinery, standard Save/Discard. -->
    <record id="view_oc_connector_settings_form" model="ir.ui.view">
        <field name="name">oc.connector.settings.form</field>
        <field name="model">oc.connector.settings</field>
        <field name="arch" type="xml">
            <form string="Connector Bridge Settings">
                <sheet>
                    <group>
                        <field name="role"/>
                        <field name="remote_url" placeholder="https://..."/>
                        <field name="api_key" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Finds (or creates) the one settings record and opens it directly,
         so the "Configuration" menu never shows a list or a "New" button. -->
    <record id="action_server_open_oc_connector_settings" model="ir.actions.server">
        <field name="name">Open Connector Bridge Settings</field>
        <field name="model_id" ref="model_oc_connector_settings"/>
        <field name="state">code</field>
        <field name="code">
record = model.get_singleton()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Connector Bridge Settings',
    'res_model': 'oc.connector.settings',
    'res_id': record.id,
    'view_mode': 'form',
    'target': 'current',
}
        </field>
    </record>
</odoo>
