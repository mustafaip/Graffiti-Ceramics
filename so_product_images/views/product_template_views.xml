<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_design_image" model="ir.ui.view">
        <field name="name">product.template.design.image</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="after">
                <field name="design_image" widget="image" string="Product Design"/>
            </xpath>
        </field>
    </record>

</odoo>
