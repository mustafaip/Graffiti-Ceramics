<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_sale_order_line_images"
              inherit_id="sale.report_saleorder_document">

        <xpath expr="//thead/tr/th[last()]" position="before">
            <th class="text-center" style="width:80px;">Product Image</th>
            <th class="text-center" style="width:80px;">Product Design</th>
        </xpath>

        <xpath expr="//tbody/tr[hasclass('o_line_section')]" position="before">
            <t t-set="line_has_images" t-value="line.include_images"/>
        </xpath>

        <xpath expr="//tbody/tr/td[last()]" position="before">
            <td class="text-center" style="vertical-align:middle; padding:4px;">
                <t t-if="line.include_images">
                    <t t-if="line.product_id.image_128">
                        <img
                            t-att-src="'data:image/png;base64,%s' % (line.product_id.image_128 or b'').decode('utf-8')"
                            style="max-width:70px; max-height:70px;"
                        />
                    </t>
                </t>
            </td>
            <td class="text-center" style="vertical-align:middle; padding:4px;">
                <t t-if="line.include_images">
                    <t t-if="line.product_id.product_tmpl_id.design_image">
                        <img
                            t-att-src="'data:image/png;base64,%s' % (line.product_id.product_tmpl_id.design_image or b'').decode('utf-8')"
                            style="max-width:70px; max-height:70px;"
                        />
                    </t>
                </t>
            </td>
        </xpath>

    </template>

</odoo>
