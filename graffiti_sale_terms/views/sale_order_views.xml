<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_terms_templates" model="ir.ui.view">
        <field name="name">sale.order.form.terms.templates</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="before">
                <field name="terms_template_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Select terms &amp; conditions..."
                       readonly="state in ('cancel', 'sale')"/>
            </xpath>
        </field>
    </record>
</odoo>
