<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Factors live on the variant (every size packs differently). The product
         form shows them only while the product has a single variant, like
         Internal Reference; the variant form always shows them. -->
    <record id="product_template_form_view_box_rounding" model="ir.ui.view">
        <field name="name">product.template.form.box.rounding</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="sqm_per_piece"
                       invisible="not is_product_variant and product_variant_count > 1"/>
                <field name="pieces_per_box"
                       invisible="not is_product_variant and product_variant_count > 1"/>
                <field name="sqm_per_box"
                       invisible="not is_product_variant and product_variant_count > 1"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_box_rounding" model="ir.ui.view">
        <field name="name">product.product.list.box.rounding</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="sqm_per_piece" optional="show"/>
                <field name="pieces_per_box" optional="show"/>
                <field name="sqm_per_box" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
