<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_alternate_name" model="ir.ui.view">
        <field name="name">sale.order.form.alternate.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Alternate-name picker takes the place of the Product column -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="before">
                <field name="alt_product_tmpl_id" column_invisible="1"/>
                <field name="alternate_name_id"
                       string="Product"
                       context="{'alt_name_only': True}"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('product_tmpl_id', '=', alt_product_tmpl_id)] if alt_product_tmpl_id else [('product_tmpl_id.sale_ok', '=', True)]"/>
            </xpath>
            <!-- Original product column stays available but hidden by default -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
