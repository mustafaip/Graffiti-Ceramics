<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_alternate_name" model="ir.ui.view">
        <field name="name">sale.order.form.alternate.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- "Sold As" sits right after the description, so the standard
                 product/description cell (and Add Section / Add Note) behave
                 exactly as in core Odoo. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                <field name="product_has_alternate_names" column_invisible="1"/>
                <field name="alternate_name_id"
                       optional="show"
                       placeholder="Regular name"
                       context="{'alt_name_only': product_template_id}"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="display_type"
                       invisible="display_type or (product_id and not product_has_alternate_names)"/>
            </xpath>
        </field>
    </record>
</odoo>
