<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_confirm_sale_order" model="res.groups">
        <field name="name">Can Confirm Sales Orders</field>
        <field name="comment">Members can confirm quotations into sales orders. Everyone else can only create and send quotations.</field>
    </record>

    <!-- Sales Managers (and therefore Administrators) keep the ability to confirm. -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sale_hide_confirm.group_confirm_sale_order'))]"/>
    </record>
</odoo>
